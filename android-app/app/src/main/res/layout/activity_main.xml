<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Tracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <!-- User Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E3F2FD"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvUserInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User ID: xxx"
                android:textSize="12sp"
                android:textColor="#777777"/>

        </LinearLayout>

        <!-- Device Registration Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Registration"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/deviceNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device Name (e.g., My Phone)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Register Device"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/holo_blue_dark"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/unregisterButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Unregister Device"
            android:textSize="16sp"
            android:background="@android:color/holo_orange_dark"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Status Card -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Device Not Registered\nRegister to start tracking"
            android:textSize="14sp"
            android:padding="16dp"
            android:background="#F5F5F5"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Logout"
            android:textSize="14sp"
            android:background="@android:color/darker_gray"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>

        <!-- Info Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This app tracks your device location 24/7 in the background.\nView locations on the website."
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>
