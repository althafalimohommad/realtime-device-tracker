# Google OAuth 2.0 Configuration
# Get your credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# JWT Secret for Mobile App Authentication (7-day tokens)
# Generate a secure random string (64+ characters recommended)
JWT_SECRET=your-jwt-secret-key-at-least-64-characters-long-for-security

# OAuth Callback URL
# For development: http://localhost:3000/auth/google/callback
# For production: https://yourdomain.com/auth/google/callback
CALLBACK_URL=http://localhost:3000/auth/google/callback

# MongoDB Atlas Connection (REQUIRED for cloud deployment)
# Get free MongoDB Atlas at: https://www.mongodb.com/cloud/atlas
# See MONGODB_SETUP.md for detailed instructions
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/devicetracker?retryWrites=true&w=majority

# Admin Dashboard Password
# Change this to a strong, secure password
ADMIN_PASSWORD=choose_a_strong_admin_password_here
